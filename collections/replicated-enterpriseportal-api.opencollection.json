        {
          "info": {
            "name": "Create an installation options record",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/app/:app_id/enterprise-portal/install-options",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              },
              {
                "name": "includeInstructions",
                "value": "",
                "type": "query",
                "description": "Whether to include install instructions in the response"
              }
            ]
          },
          "docs": "Create an installation options record for a customer describing the installation configuration. Automatically creating\na service account for the installation that can be used to perform the actual installation.\nOptionally include generated install instructions by setting the includeInstructions query parameter to true."
        },
        {
          "info": {
            "name": "Update an installation options record",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/app/:app_id/enterprise-portal/install-options/:install_options_id",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              },
              {
                "name": "install_options_id",
                "value": "",
                "type": "path",
                "description": "Install options ID from path"
              },
              {
                "name": "includeInstructions",
                "value": "",
                "type": "query",
                "description": "Whether to include install instructions in the response"
              }
            ]
          },
          "docs": "Update an existing installation options record for a customer. Only provided fields will be updated.\nYou cannot change the service account ID, instance name, or install type as these are immutable.\n\nOptionally return updated install instructions by setting the includeInstructions query parameter to true."
        },
        {
          "info": {
            "name": "Delete an installation options record",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/app/:app_id/enterprise-portal/install-options/:install_options_id",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              },
              {
                "name": "install_options_id",
                "value": "",
                "type": "path",
                "description": "Install options ID from path"
              }
            ]
          },
          "docs": "Soft-delete an existing installation options record for a customer by setting its status to \"discarded\".\nThe record is preserved for audit purposes. The associated service account is not revoked. The service account\nmust be revoked before the instance name can be reused with a new install option record for the same customer."
        },
        {
          "info": {
            "name": "Get an install options record",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/:app_id/enterprise-portal/install-options/:option_id",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              },
              {
                "name": "option_id",
                "value": "",
                "type": "path",
                "description": "The ID for a customer install options record (returned from create install options)"
              },
              {
                "name": "includeInstructions",
                "value": "",
                "type": "query",
                "description": "Whether to include install instructions in the response"
              }
            ]
          },
          "docs": "Retrieve the installation options that describe the installation configured for a customers install via the Enterprise Portal or API.\nOptionally include generated install instructions by setting the includeInstructions query parameter to true."
        },
        {
          "info": {
            "name": "Get update instructions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/:app_id/enterprise-portal/install-options/:option_id/update-instructions",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              },
              {
                "name": "option_id",
                "value": "",
                "type": "path",
                "description": "The ID for a customer install options record"
              },
              {
                "name": "instance_id",
                "value": "",
                "type": "query",
                "description": "The instance ID for a legacy/airgap instance (used when option_id is \"placeholder\")"
              },
              {
                "name": "cluster_id",
                "value": "",
                "type": "query",
                "description": "Optional cluster ID used to disambiguate a kots_license_instance row when\nthe same instance_id exists across multiple clusters."
              },
              {
                "name": "targetChannelId",
                "value": "",
                "type": "query",
                "description": "Target channel ID for the update"
              },
              {
                "name": "targetChannelSequence",
                "value": "",
                "type": "query",
                "description": "Target channel sequence for the update"
              }
            ]
          },
          "docs": "Generates step-by-step instructions for updating an installation to a specific target version.\nSupports both Helm and Linux (Embedded Cluster) installation types. The update instructions\nwill use upgrade/update commands instead of install commands, and are tailored to the\nnetwork and registry availability configuration from the original install options."
        },
