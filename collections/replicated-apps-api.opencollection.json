{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vendor API V3 apps API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an app.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/app"
          },
          "docs": "Create a new app for the team with the provided name.\nThe app will be available for further configuration and channel management.\n\nRequired RBAC Policy: kots/app/create"
        },
        {
          "info": {
            "name": "Get an app.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/:app_id",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              }
            ]
          },
          "docs": "Retrieve the details of a specific app, including its metadata and a list of associated channels.\n\nRequired RBAC Policy: kots/app/[:appid]/read"
        },
        {
          "info": {
            "name": "Delete an app.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/app/:app_id",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              }
            ]
          },
          "docs": "Delete the specified app from the team.\nThe app and all its associated resources will be removed.\n\nRequired RBAC Policy: kots/app/[:appid]/delete"
        },
        {
          "info": {
            "name": "Set a builtin license field value override for a given app and named field.",
            "type": "http"
