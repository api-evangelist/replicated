        {
          "info": {
            "name": "Export customer instances for an app as CSV or JSON.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/:app_id/customer_instances",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              },
              {
                "name": "sortColumn",
                "value": "",
                "type": "query",
                "description": "Sort column"
              },
              {
                "name": "sortDesc",
                "value": "",
                "type": "query",
                "description": "Sort descending"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Format to export: csv or json"
              },
              {
                "name": "customerIds",
                "value": "",
                "type": "query",
                "description": "Comma separated array of customer ids"
              },
              {
                "name": "IncludeArchived",
                "value": "",
                "type": "query"
              },
              {
                "name": "Query",
                "value": "",
                "type": "query",
                "description": "Customer-level filters"
              },
              {
                "name": "IncludeActive",
                "value": "",
                "type": "query"
              },
              {
                "name": "IncludeInactive",
                "value": "",
                "type": "query"
              },
              {
                "name": "IncludeArchivedCustomers",
                "value": "",
                "type": "query"
              },
              {
                "name": "LicenseType",
                "value": "",
                "type": "query"
              },
              {
                "name": "ChannelName",
                "value": "",
                "type": "query"
              },
              {
                "name": "AdoptionRateFilter",
                "value": "",
                "type": "query"
              },
              {
                "name": "IncludeArchivedInstances",
                "value": "",
                "type": "query",
                "description": "Instance-level filters"
              }
            ]
          },
          "docs": "Generate and return a report of all customer instances for a specific app, in either CSV or JSON format.\nIncludes instance metadata and supports filtering by customer IDs and archived status.\n\nRequired RBAC Policy: kots/app/[:appid]/read (app-level gate; results are also\nfiltered per-customer by kots/app/[:appid]/license/[:licenseid]/read)"
        },
        {
          "info": {
            "name": "Get customer report in CSV format.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/app/:app_id/customers_csv",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              },
              {
                "name": "sortColumn",
                "value": "",
                "type": "query",
                "description": "Sort column"
              },
              {
                "name": "sortDesc",
                "value": "",
                "type": "query",
                "description": "Sort descending"
              },
              {
                "name": "customerName",
                "value": "",
                "type": "query",
                "description": "filter by customer name"
              }
            ]
          },
          "docs": "Generate and return a CSV report of all customers for a specific app, including metadata and instance information.\n\nRequired RBAC Policy: kots/app/[:appid]/license/[:licenseid]/read"
        },
