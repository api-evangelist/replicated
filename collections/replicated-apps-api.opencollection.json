          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/app/:app_id/builtin-license-field/:field_name",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "App identifier"
              },
              {
                "name": "field_name",
                "value": "",
                "type": "path",
                "description": "Field name"
              }
            ]
          },
          "docs": "Required RBAC Policy: kots/app/[:appid]/builtin-licensefields/update"
        },
        {
          "info": {
            "name": "Delete a builtin license field override for a given app and named field.",
