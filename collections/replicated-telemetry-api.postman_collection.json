        {
          "id": "649b3f0d-00b9-48ac-bc5b-b2e418c47fce",
          "name": "Record CLI command execution event",
          "request": {
            "name": "Record CLI command execution event",
            "description": {
              "content": "Records telemetry data for a CLI command execution including exit code, duration, and environment metadata.\nReturns a unique event_id that can be used to correlate errors with this event.\n\nNote: Authentication required. Team and user information is extracted automatically from the Bearer token.\nThis endpoint is accessible to all authenticated users, including read-only users, to ensure comprehensive telemetry collection.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cli",
                "telemetry",
                "event"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
